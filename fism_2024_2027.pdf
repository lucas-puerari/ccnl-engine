<style id="wp-custom-css">



.elementor-button-icon svg {
    width: 15px;
    height: 15px;
   
}

.elementor-button-icon:hover {
    transition-duration: 0.6s ease-in-out;
    transition-timing-function: ease;
    transition-delay: 0s;
	  
}
.elementor-post__text {
    display: flex !important;
    flex-direction: column !important;
}


.elementor-11 .elementor-element.elementor-element-b1ac564 .ue_post_date {
    color: #000000;
    margin-top: 0px;
    order: 3 !important;
}


.elementor-button:hover .elementor-button-icon{
  transform: translateX(8px);
  transition: transform 0.5s ease-out;
}

.more-link {
  display: none !important;
}


div.wpforms-container-full, div.wpforms-container-full .wpforms-form * {
    text-align: center;
}

div.wpforms-container-full .wpforms-form button[type=submit] {
    width: 100%;
}


.page-content a {
    text-decoration: none;
}

a link: hover {
    color: #80ba26 !important;
}

.elementor-posts .elementor-post__read-more {
    align-self: flex-end !important;
}

.pum-trigger:hover {
  color: #80ba27 !important;
	transition: 0.3s ease;
}


.elementor-posts .elementor-post__read-more:hover {
    color: #80ba26 !important;
	transition: 0.4s;
	}

a {
    background-color: transparent;
    text-decoration: none;
    color: #0274bb;
}


table {
  background-color: transparent;
  width: 86% !important;
  padding: 5%;
  font-size: 1.0em;
  border-spacing: 0;
  border-collapse: collapse;
}

@media only screen and (max-width: 767px) {
	table {
  width: 100% !important;
		padding: 8%;
		font-size: 0.8em;
}
	}
	
	
	
	

table td, table th {
  padding: 3%;
  line-height: 1.5;
  vertical-align: top;
  border: 2px solid hsla(0, 0%, 100%, 0.5);
}

[type="submit"] {
  color: #0274bb;
  border: 1px solid #0274bb;
	margin-top: 20px;
}

[type="submit"]:hover {
  color: #00b1e1 !important;
  border: 1px solid #00b1e1 !important;
	margin-top: 20px;
}

#bwg_container1_0 #bwg_container2_0 .bwg-container-0.bwg-album-extended .bwg-item0 {
  border-radius: 0px !important;
}
  
.entry-title {
  text-align: center !important;
}


#bwg_container1_0 #bwg_container2_0 .bwg-container-0.bwg-standard-thumbnails .bwg-title2, #bwg_container1_0 #bwg_container2_0 .bwg-container-0.bwg-standard-thumbnails .bwg-ecommerce2 {
    color: #ffffffc2 !important;
    font-size: 32px !important;
}


#bwg_container1_0 #bwg_container2_0 .bwg-container-0.bwg-album-extended .bwg-extended-item {
    border-radius: 0px !important;
    margin: 20px 0px 0px 0px !important;
}


#bwg_container1_0 #bwg_container2_0 .bwg-container-0.bwg-album-extended .bwg_title_spun_0 {

    padding: 22px 0px 10px 0px !important;
}

@font-face {
    font-display: swap;
}
</style>
</head>

