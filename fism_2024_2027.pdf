			<style class="wpcode-css-snippet">/* container relative (si&#231; e kemi) */
.bwg-extended-item1 {
  position: relative;
}

/* butoni djathtas */
.bwg-gallery-btn {
  position: absolute;
  right: 20px;
  bottom: 5%;
  transform: translateY(-50%);

  display: inline-flex;
  align-items: center;
  gap: 2px;

  background: none;
  color: #000;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  padding: 0;
  white-space: nowrap;
}

/* IKONA me path-in t&#235;nd (SVG data-uri) */
.bwg-gallery-btn::after {
  content: "";
  width: 15px;
  height: 15px;
  display: inline-block;

  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;

  background-image: url("data:image/svg+xml;utf8,\
<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 154 307'>\
<path d='M153.68 153.56 L0.56 0.44 L0.56 306.68 L153.68 153.56 Z' fill='rgb(128,186,38)'/>\
</svg>");
}

/* hover minimal */
.bwg-gallery-btn:hover {
  text-decoration: underline;
}

/* tranzicion i but&#235; p&#235;r ikon&#235;n */
.bwg-gallery-btn::after {
  transition: transform 0.25s ease;
}

/* hover: ikona zhvendoset djathtas */
.bwg-gallery-btn:hover::after {
  transform: translateX(6px);
}

/* MOBILE FIX */
@media (max-width: 767px) {

  .bwg-gallery-btn {
    position: static;          /* hiq absolute */
    transform: none;
    margin-top: 22px;
	  padding-top: 27px !important;
	  padding-bottom: 10px !important;

    justify-content: flex-end;
  }

  .bwg-extended-item1 {
    padding-bottom: 0;         /* siguri ndaj overlap */
  }

}</style>
