  "requirements": [
    {
      "id": "contractual_fund_partial",
      "institute": "pension_fund_contribution",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The Fondapi contractual contribution (5 EUR riparametrati a month) is owed on every run that pays the month, in full. The Scheda and the circolare operativa of Fondapi state no rule for a partly employed month, a part-time worker or the extra months: a partial month or part time pays the full amount, an extra-month run none.",
      "calculation": "ccnl/materiali-costruzione-lapidei-confapi:coverage.notes",
      "state": "unverified",
      "remediation": "Source the rule of the accordo of 10 November 2020 for a partial month and part time and model it, then remove this note.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "materiali-costruzione-lapidei-confapi/contractual_fund_partial"
        ]
      }
    },
    {
      "id": "parental_top_up_scope",
      "institute": "parental_leave",
      "variant": "all",
      "discriminant": "applies_when.trigger = outside_input",
      "rule": "Art. 52 permits hourly parental leave but does not specify its hourly quota: the event uses the statutory half-day fallback. This agreement also lacks a modelled daily absence quota, so its leave handler posts no payment until that quota is sourced. 'Un periodo non superiore a tre mesi' is read as 90 equivalent days; employer absorption of company provisions is not modelled. The top-up uses the INPS daily base (art. 23 D.Lgs. 151/2001), not an independently established collective pay base. Earlier topped-up days are supplied by the caller, not carried automatically between events.",
      "calculation": "ccnl/materiali-costruzione-lapidei-confapi:coverage.notes",
      "state": "absent",
      "remediation": "Source a daily absence quota to activate the leave handler; verify the hourly quota and collective pay base, interpret the three-month cap, model company-provision absorption, and carry supplemented days per child across events.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "materiali-costruzione-lapidei-confapi/parental_top_up_scope"
        ]
      }
    },
