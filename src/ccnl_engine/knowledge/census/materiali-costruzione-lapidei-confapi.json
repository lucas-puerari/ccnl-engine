    {
      "id": "cigo_rate_by_activity",
      "institute": "inps_employer",
      "variant": "operaio",
      "discriminant": "applies_when.trigger = run",
      "rule": "CIGO: the operai of the stone-working firms owe 3.30% ('operai delle imprese dell'industria e artigianato lapidei', D.Lgs. 148/2015 art. 13 c. 1 (Normattiva, text in force on 2026-10-14, https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2015-09-14;148~art13!vig=2026-10-14, snapshot sha256 3f7019a244e01d36ac8e7c9e25bcf058c777c8ed758418ba261d83867672c46a), lett. d); the industria table charges the 1.70% / 2.00% of lett. a-b, so the employer contributions of an operaio are understated by 1.60 or 1.30 points. Impiegati and quadri owe the 1.70% / 2.00% of lett. e-f the table already charges.",
      "calculation": "ccnl/materiali-costruzione-lapidei-confapi:coverage.notes",
      "state": "absent",
      "work": [
        "T04.10"
      ],
      "verification": [
        "T04.12"
      ],
      "origin": "seeded",
      "links": {
        "limitations": [
          "materiali-costruzione-lapidei-confapi/cigo_rate_by_activity"
        ]
      }
    },
    {
      "id": "contractual_fund_partial",
      "institute": "pension_fund_contribution",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The Fondapi contractual contribution (5 EUR riparametrati a month) is owed on every run that pays the month, in full. The Scheda and the circolare operativa of Fondapi state no rule for a partly employed month, a part-time worker or the extra months: a partial month or part time pays the full amount, an extra-month run none.",
      "calculation": "ccnl/materiali-costruzione-lapidei-confapi:coverage.notes",
      "state": "unverified",
      "work": [
        "T05.06"
      ],
      "verification": [
        "T05.10"
      ],
      "origin": "seeded",
      "links": {
        "limitations": [
          "materiali-costruzione-lapidei-confapi/contractual_fund_partial"
        ]
      }
    },
    {
      "id": "provisional_inps_ruleset",
      "institute": "inps_employer",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The run reads an INPS ruleset marked provisional: the INPS circulars of its year are not published yet, so the rates, the massimale and the minimale (and the hourly contributions of domestic work) are those of the year before, carried over. The indexed amounts change every January: the carried-over values understate them.",
      "calculation": "ccnl_engine.assurance.ruleset.services.provisional_paths (INPS ruleset of the run)",
      "state": "unverified",
      "work": [
        "T00.03",
        "T09.03"
      ],
      "verification": [
        "T00.12",
        "T09.11"
      ],
      "origin": "seeded",
      "links": {
        "limitations": [
          "provisional_inps_ruleset"
        ]
      }
    },
    {
      "id": "provisional_ruleset",
      "institute": "irpef",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The run reads a tax ruleset marked provisional: the sources of its year are not published yet (budget law of the year; regional and municipal surtax resolutions), so the values are those of the year before, carried over. Rules in force by statute (the IRPEF brackets of art. 11 and the deductions of art. 13 of the testo unico of D.Lgs. 117/2026) carry over unchanged; any change of the budget law is not applied.",
      "calculation": "ccnl_engine.assurance.ruleset.services.provisional_paths (tax ruleset of the run)",
      "state": "unverified",
      "work": [
        "T00.03",
        "T09.03"
      ],
      "verification": [
        "T00.12",
        "T09.11"
      ],
      "origin": "seeded",
      "links": {
        "limitations": [
          "provisional_ruleset"
        ]
      }
    },
