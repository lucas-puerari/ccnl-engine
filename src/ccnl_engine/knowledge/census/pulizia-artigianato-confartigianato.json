{
  "schema_version": 1,
  "ccnl_id": "pulizia-artigianato-confartigianato",
  "requirements": [
    {
      "id": "inps_sector_rates_unsourced",
      "institute": "inps_employer",
      "variant": "all",
      "discriminant": "applies_when.trigger = run",
      "rule": "INPS RATES: the employer and worker INPS rates of the sector (artigianato) are totals no 2026 INPS or association table confirms: the only component split found is the INPS guide of 2012 and the 2026 totals come from a software house page that does not prove its year. The contributions of every run rest on them.",
      "calculation": "ccnl/pulizia-artigianato-confartigianato:coverage.notes",
      "state": "unverified",
      "remediation": "Source the artigianato rates of 2026 on an INPS or association table, mark the inps block of contribution/2026/artigianato.json derived, then remove this note.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "pulizia-artigianato-confartigianato/inps_sector_rates_unsourced"
        ]
      }
    },
    {
      "id": "overtime_weekly_threshold",
      "institute": "overtime",
      "variant": "all",
      "discriminant": "applies_when.trigger = run",
      "rule": "SIMPLIFICATION: Soglia settimanale ore straordinarie (OT_DIURNO) non modellata (hour_threshold_per_week=null). Il contratto prevede scatto dopo 40h/settimana e limite annuale 200h. Coverage work_rules gia' marcata partial.",
      "calculation": "ccnl/pulizia-artigianato-confartigianato:coverage.notes",
      "state": "unverified",
      "remediation": "Model the 40-hour weekly threshold and the 200-hour yearly cap of OT_DIURNO, or pass the multiplier on the overtime event.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "pulizia-artigianato-confartigianato/overtime_weekly_threshold"
        ]
      }
    },
    {
      "id": "parental_hourly_ccnl_rule",
      "institute": "parental_leave",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "A parental leave by the hour takes half the average daily hours a day and counts two such days as one day of leave, the general criterion of art. 32 c. 1-ter D.Lgs. 151/2001 (INPS circ. 152/2015 par. 2.2); a collective agreement, also of the company, that sets other hours to a day of leave or other rules of cumulation prevails, and the bundle holds none.",
      "calculation": "ccnl_engine.absence.insured.parental.hourly.handlers._handle_hourly_parental; INPS circ. 152/2015 (sha256 6e74e62dd50378c23117df7aaca509ab9b8b93e60f99cad23e9c64982fd3734e) par. 2.2; INPS msg. 6704/2015 (sha256 df53a5985edfad727f8f7fcab3c2e21ee70181181ef35194935394157ef12204)",
      "state": "unverified",
      "remediation": "Source the collective rules on the leave by the hour of the CCNL (hours of a day of leave, cumulation) and apply them, then resolve this limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "parental_hourly_ccnl_rule"
        ]
      }
    },
