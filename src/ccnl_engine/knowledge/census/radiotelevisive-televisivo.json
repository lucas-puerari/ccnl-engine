      "variant": "all",
      "discriminant": "applies_when.trigger = run",
      "rule": "INPS rates reuse existing 2026-industria.json (tax_sector=industria). No bilateral fund substitution for broadcasting sector identified; standard Confindustria INPS rates apply.",
      "calculation": "ccnl/radiotelevisive-televisivo:coverage.notes",
      "state": "unverified",
      "remediation": "Confirm the 2026 INPS rates of the broadcasters (industria, CIGO vs FIS by size) against the INPS circular, and route the roles insured in the ex-ENPALS FPLS to that regime.",
      "origin": "seeded",
      "links": {
