{
  "schema_version": 1,
  "ccnl_id": "vetro-meccanizzato-assovetro",
  "requirements": [
    {
      "id": "other_subsectors_tables",
      "institute": "base_salary",
      "variant": "all",
      "discriminant": "applies_when.trigger = outside_input",
      "rule": "SCOPE: Settori meccanizzati (prime lavorazioni) only — 6 base sub-levels (A, B, C, D, E, F). Other sub-sectors (trasformazione, soffio, lampade e display) and sub-levels (A2, B2, C2, D2, D3, E2, E3) not modelled.",
      "calculation": "ccnl/vetro-meccanizzato-assovetro:coverage.notes",
      "state": "absent",
      "remediation": "Model the trasformazione, soffio and lampade e display tables with a sub-sector input, or record the limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "vetro-meccanizzato-assovetro/other_subsectors_tables"
        ]
      }
    },
    {
      "id": "provisional_inps_ruleset",
      "institute": "inps_employer",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The run reads an INPS ruleset marked provisional: the INPS circulars of its year are not published yet, so the rates, the massimale and the minimale (and the hourly contributions of domestic work) are those of the year before, carried over. The indexed amounts change every January: the carried-over values understate them.",
      "calculation": "ccnl_engine.assurance.ruleset.services.provisional_paths (INPS ruleset of the run)",
      "state": "unverified",
      "remediation": "Replace each provisional INPS ruleset of the year with the values of the INPS circulars of the year, drop its provisional flag, then resolve this limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "provisional_inps_ruleset"
        ]
      }
    },
    {
      "id": "provisional_ruleset",
      "institute": "irpef",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "The run reads a tax ruleset marked provisional: the sources of its year are not published yet (budget law of the year; regional and municipal surtax resolutions), so the values are those of the year before, carried over. Rules in force by statute (the IRPEF brackets of art. 11 and the deductions of art. 13 of the testo unico of D.Lgs. 117/2026) carry over unchanged; any change of the budget law is not applied.",
      "calculation": "ccnl_engine.assurance.ruleset.services.provisional_paths (tax ruleset of the run)",
      "state": "unverified",
      "remediation": "Replace each provisional ruleset of the year with the values of its published sources, drop its provisional flag, then resolve this limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "provisional_ruleset"
        ]
      }
    },
