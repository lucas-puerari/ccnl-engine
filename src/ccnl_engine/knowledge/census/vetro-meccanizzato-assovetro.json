    {
      "id": "other_subsectors_tables",
      "institute": "base_salary",
      "variant": "all",
      "discriminant": "applies_when.trigger = outside_input",
      "rule": "SCOPE: Settori meccanizzati (prime lavorazioni) only — 6 base sub-levels (A, B, C, D, E, F). Other sub-sectors (trasformazione, soffio, lampade e display) and sub-levels (A2, B2, C2, D2, D3, E2, E3) not modelled.",
      "calculation": "ccnl/vetro-meccanizzato-assovetro:coverage.notes",
      "state": "absent",
      "remediation": "Model the trasformazione, soffio and lampade e display tables with a sub-sector input, or record the limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "vetro-meccanizzato-assovetro/other_subsectors_tables"
        ]
      }
    },
    {
      "id": "parental_hourly_ccnl_rule",
      "institute": "parental_leave",
      "variant": "all",
      "discriminant": "applies_when.trigger = path",
      "rule": "A parental leave by the hour takes half the average daily hours a day and counts two such days as one day of leave, the general criterion of art. 32 c. 1-ter D.Lgs. 151/2001 (INPS circ. 152/2015 par. 2.2). A national CCNL rule that sets other hours to a day of leave or other rules of cumulation prevails (art. 32 c. 1-bis), and the bundle holds none; a company or territorial agreement is the fact local_hourly_agreement of the event. Same-day cumulation with the other permits and rests of the decree, which the criterion excludes, is not checked.",
      "calculation": "ccnl_engine.absence.insured.parental.hourly.handlers._handle_hourly_parental; INPS circ. 152/2015 (sha256 6e74e62dd50378c23117df7aaca509ab9b8b93e60f99cad23e9c64982fd3734e) par. 2.2; INPS msg. 6704/2015 (sha256 df53a5985edfad727f8f7fcab3c2e21ee70181181ef35194935394157ef12204)",
      "state": "unverified",
      "remediation": "Source the collective rules on the leave by the hour of the CCNL (hours of a day of leave, cumulation) and apply them, then resolve this limitation.",
      "origin": "seeded",
      "links": {
        "limitations": [
          "parental_hourly_ccnl_rule"
        ]
      }
    },
