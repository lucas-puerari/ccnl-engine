  "coverage": {
    "layer_1": "implemented",
    "layer_2": "partial",
    "notes": [
      {
        "kind": "info",
        "text": "CCNL A016 — Cooperative e Consorzi Agricoli. Conglobated model. 8 livelli: np-7-6-5-4-3-2-1. Divisore 169, 14 mesi. 4 tranches: apr-2024, mag-2025, mag-2026, feb-2027."
      },
      {
        "kind": "info",
        "text": "Quadri: i livelli 1Q e 2Q del precedente impianto corrispondono a livello 1° e 2° con aggiunta dell'indennità di funzione quadri (Art. 45): 1Q +EUR 180→230/mese, 2Q +EUR 125→160/mese dal 01/08/2024. Modellata come fixed_allowance a 14 mensilità su ciascun livello."
      },
      {
        "kind": "simplification",
        "text": "Scatti anzianità: Art. 61 (operai, max 5 biennali) e Art. 49 (impiegati, max 12 biennali) hanno importi differenti per i livelli 3-7. Modellati con gli importi operai (dominanti nelle cooperative). maximum_count=12 (impiegati); query operai con seniority_count>5 producono scatti sovrastimati."
      },
      {
        "kind": "simplification",
        "text": "Apprendistato: regola non reperita nel PDF 2024. Modellato come 100% passthrough."
      }
    ]
  },
