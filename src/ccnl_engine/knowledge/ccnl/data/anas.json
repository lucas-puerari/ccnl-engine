  "coverage": {
    "notes": [
      {
        "kind": "info",
        "text": "Split model: minimo tabellare + IIS (Indennita Integrativa Speciale, frozen). 7 levels C1-C-B2-B1-B-A1-A. Divisor 156, 13 months. 4 tranches: 01/03/2026, 01/09/2026, 01/03/2027, 01/07/2027."
      },
      {
        "kind": "simplification",
        "text": "IIS months_per_year=13 assumed equal to additional_months; verify against contract text."
      },
      {
        "kind": "simplification",
        "text": "Seniority maximum_count=10 — no explicit cap found in source; verify against art. on scatti di anzianita."
      },
      {
        "kind": "simplification",
        "text": "Apprenticeship 70/85/92% from contract text; last period open-ended (months_until=null at 92%)."
      },
      {
        "kind": "simplification",
        "text": "Overtime base (Art. 101): la retribuzione oraria include minimo tabellare + contingenza (IIS) + RIA + AEP + EDR. Il modello usa hourly_base_method=minimo_tabellare (sottostima); le voci aggiuntive non sono modellate."
      },
      {
        "kind": "simplification",
        "text": "Art. 101 prevede OT festivo-notturno al 85%: non modellato (nessun WorkKind combinato night+holiday nello schema)."
      },
      {
        "kind": "simplification",
        "text": "Malattia (Art. 48): mesi 13-18 al 50% non catturati da SicknessRules (schema a tasso unico)."
      }
    ],
    "gross": "implemented",
    "net": "implemented",
    "work_rules": "implemented"
  },
