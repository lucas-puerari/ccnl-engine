    "notes": [
      {
        "kind": "info",
        "text": "CCNL HV17 FEDERDAT SF (Servizi Fiduciari) section. Conglobated, divisor 173. 5 levels (A-E). 14a mensilita from 01/01/2024; before that 13 months. 8 tranches, last at 01/04/2026 (SF schedule). Level F absent from tables (may be entry/apprenticeship only; verify base CCNL 2013)."
      },
      {
        "kind": "simplification",
        "text": "Seniority amounts not found in renewal PDF (base CCNL 2013, art. 23 SF). Cadence 36m and max 6 scatti assumed (same as GPG section). Amounts are approximate proxies; verify against base text."
      },
      {
        "kind": "simplification",
        "text": "Apprenticeship: 100% passthrough. Rules not found in renewal document; verify against CCNL FEDERDAT base text."
      },
      {
        "kind": "simplification",
        "text": "additional_months=13 for the period 01/06/2023-01/01/2024; 14 from 01/01/2024 onward. Level E is used for first 9 months of tenure (per contract text)."
      }
    ]
