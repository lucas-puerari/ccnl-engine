  "coverage": {
    "layer_1": "implemented",
    "layer_2": "implemented",
    "notes": [
      {
        "kind": "info",
        "text": "CCNL signed 04/12/2023 valid 01/01/2023-31/12/2025; renewed 30/01/2026 valid 01/01/2026-31/12/2028 (ANFAO+Filctem-CGIL+Femca-CISL+UilTEC-UIL)."
      },
      {
        "kind": "info",
        "text": "CONGLOBATED (since 01/01/2009): contingenza and EDR are inglobated into the tabular minimum. Single base_salary column per level; no separate contingenza allowance."
      },
      {
        "kind": "info",
        "text": "Level Q (Quadro): indennita di funzione +82.63 EUR/month on top of the tabular minimum (all tranches). Modelled as INDENNITA_FUNZIONE fixed allowance, months_per_year=13."
      },
      {
        "kind": "info",
        "text": "HOURLY DIVISOR: 173 (standard 40h/week). Shift workers on 6x6 turns use divisor 156; engine models the 173 case uniformly."
      },
      {
        "kind": "info",
        "text": "SENIORITY: 5 biennali (24-month) scatti. Per-level amounts (EUR): 1=6.84, 2=7.36, 3=3S=7.80, 4=4S=8.26, 5=5S=9.76, 6=Q=11.65."
      },
      {
        "kind": "simplification",
        "text": "LEVEL 1 sub-level: contract provides automatic advancement from entry sub-level after 6 months. Tabular values shown are the post-advance minimum, used as the single level-1 series throughout."
      },
      {
        "kind": "simplification",
        "text": "TRANCHES 01/10/2026 through 01/11/2028: only the L4 reference increase is confirmed from primary source (CISL communique: +30, +50, +45, +20 EUR). All-level amounts computed using the parametric ratio matrix derived from the confirmed 01/03/2026 per-level deltas. This matches the contractual parametric mechanism."
      },
      {
        "kind": "simplification",
        "text": "APPRENTICESHIP: type (percentage vs under_classification) not confirmed from public sources. Modelled as 100% passthrough for all levels; correct for permanent workers."
      }
    ]
  },
