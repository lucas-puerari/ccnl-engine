  "coverage": {
    "notes": [
      {
        "kind": "info",
        "text": "CCNL OO.SS. signed 19/01/2023 by UNSIC/CONFSAL. Valid 01/01/2023-31/12/2025; renewed 26/03/2026 for 01/01/2026-31/12/2028."
      },
      {
        "kind": "info",
        "text": "Salary model: conglobated. Art. 49 states 'paga base nazionale conglobata'. No split components."
      },
      {
        "kind": "info",
        "text": "6 levels (1=highest: Direttore Generale, 6=lowest: Usciere/Fattorino). Art. 49 table."
      },
      {
        "kind": "info",
        "text": "Hourly divisor 170: Art. 49 explicit ('divisore convenzionale 170'). Verified: 2746.80/170=16.16, 2065.40/170=12.15, 1565.30/170=9.21."
      },
      {
        "kind": "info",
        "text": "Additional months: 14. Art. 52: gratifica natalizia (13ma) + quattordicesima mensilita."
      },
      {
        "kind": "info",
        "text": "Seniority (Art. 51): triennale (36mo), max 5 scatti, 1% of current tabellare. Amounts stored per tranche."
      },
      {
        "kind": "info",
        "text": "Apprenticeship (Art. 15): under_classification, max 2 levels below destination. 3 tracks (dest 3,4,5). Duration 36mo each with 18/18 split confirmed from CCNL text."
      },
      {
        "kind": "info",
        "text": "No dedicated INPS code per contratticcnl.it. Tax sector=terziario applied."
      },
      {
        "kind": "info",
        "text": "Headcount: 6,968 workers, 830 employers (ADAPT 18 Rapporto CNEL)."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: 2026 salary values (L1=2788.00, L2=2331.75, L3=2096.38, L4=1863.44, L5=1735.04, L6=1588.78) sourced from proxy (kitech.it) for the 2026-2028 renewal. Primary source PDF covers 2023-2025 only."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: dest level 5 apprenticeship: lb=2 is structurally impossible (only 1 level below exists). Modelled as lb=1 for full 36mo duration per Art. 15 cap ('non piu di due livelli')."
      }
    ],
    "gross": "implemented",
    "net": "implemented"
  },
