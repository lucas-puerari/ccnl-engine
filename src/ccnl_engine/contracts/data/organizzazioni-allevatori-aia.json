    "layer_2": "out_of_scope",
    "notes": [
      {
        "kind": "info",
        "text": "Salary model: conglobated. Wolters Kluwer tables show Minimo = Totale with no separate contingenza column. fixed_allowances = [] for all levels."
      },
      {
        "kind": "info",
        "text": "Hourly divisor 164.67 = 38h/week x 52 / 12, confirmed from Art. 11 CCNL (FLAI PDF). Tredicesima + quattordicesima = 14 additional months (Art. 17 CCNL)."
      },
      {
        "kind": "info",
        "text": "Seniority: 10 biennial scatti per Art. 18 CCNL (FLAI PDF + Confederdia confirmed). Cadence biennale (24 months). Amounts effective 2025-01-01 per Dec 2024 economic renewal."
      },
      {
        "kind": "info",
        "text": "Indennita di funzione for Quadri (area 1): at least 13% of monthly salary per Art. 19 CCNL. Not modeled: percentage-based floor, not a fixed amount."
      },
      {
        "kind": "info",
        "text": "Apprenticeship: Annex 4 (profili formativi) referenced but not publicly parsed. layer_2 = out_of_scope."
      },
      {
        "kind": "info",
        "text": "Headcount: ~1,822 workers (AIA, CNEL archive 2023)."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: First tranche (Jan 2025) from Dec 2024 renewal not modeled; no per-level table confirmed for that date. Engine returns no result for as_of before 2025-09-01."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: Third tranche (Sep 2026) not modeled; per-level amounts not yet published in primary sources."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: Indennita di funzione for area 1 Quadri (min 13% monthly) not modeled — variable floor amount, not expressible as fixed allowance."
      }
    ]
  },
