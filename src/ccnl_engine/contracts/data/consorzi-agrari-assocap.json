    "notes": [
      {
        "kind": "info",
        "text": "Salary model: split (paga base + contingenza) confirmed from ilccnl.it tables showing separate paga base, contingenza, and terzo elemento (0.00) columns."
      },
      {
        "kind": "info",
        "text": "Indennita di funzione modeled as INDENNITA_DI_FUNZIONE fixed_allowance for levels Q (335.50), 1 (192.50), 2 (115.50 EUR/month). Source: kitech."
      },
      {
        "kind": "info",
        "text": "Seniority: 5 biennial scatti per Art. 34 CCNL (FLAI-CGIL PDF primary source). Scatto amounts from kitech Jan 2026 table; applied from 2025-01-01 — no Jan 2025 per-level table found in public sources."
      },
      {
        "kind": "info",
        "text": "Apprenticeship: Art. 16 delegates rules to Annex E, not publicly available. layer_2 = out_of_scope."
      },
      {
        "kind": "info",
        "text": "Headcount: ~2,133 workers (ASSOCAP, CNEL archive 2023)."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: Jan 2024 tranche (first of four per 12/12/2023 accord) not modeled; no per-level table found in public sources. Engine returns no result for as_of before 2025-01-01."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: Jan 2027 tranche not yet published per-level; not modeled."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: Indennita di cassa (EUR 55.00/month, cashiers only) not modeled — applies only to a subset of workers."
      },
      {
        "kind": "simplification",
        "text": "SIMPLIFICATION: FILCOOP SANITARIO bilateral health fund not modeled."
      }
    ]
