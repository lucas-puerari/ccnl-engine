    "notes": [
      {
        "kind": "info",
        "text": "CCNL 2022-2025 signed 24/11/2022 (valid 01/04/2022-31/03/2025). CCNL 2025-2028 signed 15/07/2025 (valid 01/04/2025-31/03/2028). Signatories: Confindustria Marmomacchine+ANEPLA+FENEAL-UIL+FILCA-CISL+FILLEA-CGIL."
      },
      {
        "kind": "info",
        "text": "SPLIT model: paga base + contingenza frozen Nov 1991 + EDR 10.33 EUR. Paga base changes at each tranche; contingenza and EDR modelled as fixed_allowances."
      },
      {
        "kind": "info",
        "text": "2022-2025 paga base tranches: 31/12/2022 (base), 01/01/2023 (+40 EUR at C), 01/01/2024 (+39 EUR at C), 01/01/2025 (+44 EUR at C). Confirmed from consulenza.it per-level tables."
      },
      {
        "kind": "info",
        "text": "2025-2028 totals confirmed from cdltorino.it: 01/07/2025, 01/07/2026, 01/07/2027 (+80 EUR per tranche at C reference). Paga base derived by subtracting frozen contingenza and EDR from confirmed totals."
      },
      {
        "kind": "info",
        "text": "LEVEL F superminimum: +7.75 EUR/month collective superminimum treated as paga base for contractual purposes. Added to paga base values in this file."
      },
      {
        "kind": "info",
        "text": "HOURLY DIVISOR: 174. Daily divisor: 25."
      },
      {
        "kind": "info",
        "text": "ADDITIONAL MONTHS: 13 (tredicesima only)."
      },
      {
        "kind": "info",
        "text": "SENIORITY: 5 biennali (24-month) scatti. Per-level EUR amounts: F=6.65, E=7.69, D=8.31, C=8.82, CS=9.45, B=9.80, A=11.97, AS=13.01. Confirmed from ilccnl.it."
      },
      {
        "kind": "simplification",
        "text": "PRE-31/12/2022 HISTORY: the 2022-2025 CCNL is retroactively valid from 01/04/2022. Values for April 2022 through November 2022 are not modelled (data not retrieved from public sources). Engine history starts at 31/12/2022."
      },
      {
        "kind": "simplification",
        "text": "APPRENTICESHIP: type not confirmed from public sources. Modelled as 100% passthrough for all levels (correct for permanent workers)."
      }
    ]
  },
