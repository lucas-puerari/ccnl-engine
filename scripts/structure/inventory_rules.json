{
  "description": "Ordered rules and per-file overrides that map every tracked file under src, tests, demo and scripts to its path in the architecture contract (docs/engine/architecture-contract.md). Overrides win over rules; the first matching rule applies.",
  "rules": [
    {
      "pattern": "^(?P<path>src/ccnl_engine/(?:contract|tax|comparison|provenance|knowledge|payroll)(?:/[a-z_]+)*/__init__\\.py)$",
      "target": "{path}"
    },
    {
      "pattern": "^(?P<path>src/ccnl_engine/(?:api|errors|primitives|validation|validation_collection)\\.py)$",
      "target": "{path}"
    },
    {
      "pattern": "^(?P<path>src/ccnl_engine/(?:contract|tax|comparison|provenance|payroll)/[a-z_]+/[a-z_]+\\.py)$",
      "target": "{path}"
    },
    {
      "pattern": "^(?P<path>src/ccnl_engine/knowledge/(?:[a-z_]+/)?[a-z_]+\\.py)$",
      "target": "{path}"
    },
    {
      "pattern": "^(?P<path>tests/(?:unit|integration)/ccnl_engine/(?:contract|tax|comparison|provenance|knowledge|payroll)/(?:[a-z_]+/)?[a-z_]+\\.py)$",
      "target": "{path}"
    },
    {
      "pattern": "^src/ccnl_engine/(?P<name>__init__\\.py|py\\.typed|catalog\\.py|events\\.py|inputs\\.py|results\\.py|version\\.py)$",
      "target": "src/ccnl_engine/{name}"
    },
    {
      "pattern": "^src/ccnl_engine/knowledge/(?P<path>manifest\\.json|(?:contract|social_security|taxation|surtax|capability|limitation|policy)/[a-z0-9_/-]+\\.json)$",
      "target": "src/ccnl_engine/knowledge/{path}"
    },
    {
      "pattern": "^(?P<path>scripts/(?:distribution|documentation|knowledge|provenance|quality|structure)/[a-z_]+\\.(?:py|json))$",
      "target": "{path}"
    },
    {
      "pattern": "^(?P<path>demo/localization/[a-z]+\\.json)$",
      "target": "{path}"
    },
    {
      "pattern": "^demo/(?P<name>app\\.py|index\\.html|style\\.css|ui\\.js)$",
      "target": "demo/{name}"
    },
    {
      "pattern": "^tests/(?P<name>conftest\\.py|README\\.md)$",
      "target": "tests/{name}"
    },
    {
      "pattern": "^(?P<path>tests/(?:knowledge|unit|integration)/(?:ccnl_engine|demo|scripts)/.+)$",
      "target": "{path}"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/application/(?P<sub>period|withholding|year)/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/{sub}/services_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/application/amounts/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/amount/services_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/application/handlers/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/event/handlers_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/application/invariants/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/assurance/validators_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/application/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/period/services_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/domain/events/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/event/inputs_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/domain/input_defaults/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/period/policies_default_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/domain/pay_items/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/amount/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/domain/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/period/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/service/family/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/family/rules_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/payroll/service/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/payroll/period/rules_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/contract/domain/identity/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/contract/identity/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/contract/domain/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/contract/identity/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/contract/(?:application|service)/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/contract/catalog/services_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/tax/domain/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/tax/annual/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/tax/service/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/tax/annual/loaders_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/provenance/domain/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/provenance/ruleset/models_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/knowledge/service/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/knowledge/loaders_{n}.py"
    },
    {
      "pattern": "^src/ccnl_engine/diff/service/_?(?P<n>[a-z0-9_]+)\\.py$",
      "target": "src/ccnl_engine/comparison/ruleset/services_{n}.py"
    }
  ],
  "overrides": {}
}
